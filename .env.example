# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="Web Assistant"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Langfuse Settings
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com

# ═══════════════════════════════════════════════════════════════════════════════════════════════
# LLM Settings — ONE knob. MODEL is a "provider:model" string; the provider is inferred from the
# prefix and dispatched by LangChain's init_chat_model. Set only the API key of the provider you use;
# LangChain reads it from the environment. Startup builds MODEL once and fails fast with a clear
# message if its key is missing.
#
#   MODEL=anthropic:claude-sonnet-5      → needs ANTHROPIC_API_KEY            (prompt caching auto-on)
#   MODEL=openai:gpt-4o                  → needs OPENAI_API_KEY
#   MODEL=azure_openai:<deployment>      → needs AZURE_OPENAI_* (endpoint + key + version)
#   MODEL=ollama:llama3.3                → open-weight local models; no key, see OLLAMA_BASE_URL
#   MODEL=openai:<model> + OPENAI_BASE_URL → any OpenAI-compatible server (vLLM, LM Studio,
#                                            LiteLLM proxy, OpenRouter…); key optional
#   MODEL=<other>:<model>                → any other init_chat_model provider (groq:, google_genai:,
#                                            mistralai:…) — install its langchain-* package and set
#                                            its standard env key (e.g. GROQ_API_KEY)
# ═══════════════════════════════════════════════════════════════════════════════════════════════
MODEL=anthropic:claude-sonnet-5
MODEL_MAX_TOKENS=8192           # output cap (Anthropic requires one; harmless on OpenAI/Azure)
MODEL_CALL_LIMIT=40             # per-turn semantic cap (agent ends gracefully; client offers "continuar")
TURN_TIMEOUT_SECONDS=600        # wall-clock ceiling per turn (0 = off) — protects against hung/slow providers
MAX_AUTO_CONTINUES=2            # server-side resumptions of a step-capped turn (0 = off); the client opts in per request
TOKEN_BUDGET_DAILY=0            # per-user daily token budget (0 = off); per-account override on user.token_budget_daily

# ── Operational storage & retention (see docs/operations.md) ──
# Where approved artifacts are written when the granted folder is read-only. NEVER /tmp in
# production: a container restart deletes it and the artifact download 404s. Mount a volume.
ARTIFACT_STORAGE_ROOT=./data/artifacts
# Retention windows in days; 0 = keep forever. Conversation windows are OFF by default — deleting
# a user's history because of a default nobody chose is worse than a large table.
# RETENTION_MESSAGES_DAYS=0
# RETENTION_EVENTS_DAYS=0
# RETENTION_USAGE_DAYS=400
# RETENTION_ARTIFACTS_DAYS=30
# OUTPUT_SAFETY_AUDIT_ENABLED=false   # model-based safety audit of streamed answers (audit only — see docs/security.md)

# ── Provider API keys ── set ONLY the one your MODEL uses; leave the rest blank.
ANTHROPIC_API_KEY="your-anthropic-api-key"
OPENAI_API_KEY="your-openai-api-key"

# ── Azure OpenAI ── only when MODEL=azure_openai:<deployment>. The part after the ":" in MODEL is the
# deployment NAME you created in the Azure portal (not a base model id). Endpoint + version are read
# from here (Azure needs them in addition to the key).
AZURE_OPENAI_ENDPOINT="https://<resource>.openai.azure.com"
AZURE_OPENAI_API_KEY="your-azure-openai-api-key"
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# ── Ollama (open-weight local models) ── only when MODEL/UTILITY_MODEL/EMBEDDINGS_MODEL use the
# "ollama:" prefix. No API key — just the server address (default shown).
# OLLAMA_BASE_URL=http://localhost:11434

# ── OpenAI-compatible server ── point "openai:<model>" at vLLM / LM Studio / a LiteLLM proxy /
# OpenRouter instead of api.openai.com. When set, OPENAI_API_KEY becomes optional (any value works
# for local servers; OpenRouter/LiteLLM-with-auth still need their real key in OPENAI_API_KEY).
# OPENAI_BASE_URL=http://localhost:8080/v1

# ── Utility (cheap) model ── low-stakes sub-flows (file descriptions, safety check, research
# internals). Blank = reuse MODEL. Same "provider:model" format, e.g. openai:gpt-5-nano.
UTILITY_MODEL=

# ── Long-term memory (mem0) + embeddings ── Embeddings are a SEPARATE provider because Anthropic has
# no embedding model. EMBEDDINGS_MODEL is a "provider:model" string (e.g. openai:text-embedding-3-small
# or ollama:nomic-embed-text for a fully local setup); blank = auto-resolve from whichever of
# OpenAI/Azure has a key (Ollama is never auto-picked — set it explicitly), else memory turns off with
# a startup warning. Set LONG_TERM_MEMORY_ENABLED=false to disable it outright.
LONG_TERM_MEMORY_ENABLED=true
EMBEDDINGS_MODEL=              # e.g. openai:text-embedding-3-small | ollama:nomic-embed-text  (blank = auto/off)
# Embedding vector size — 0/blank = provider default (1536 OpenAI/Azure, 768 Ollama nomic-embed-text).
# Must match the embedder model; pgvector's collection is created with this dimension.
# EMBEDDINGS_DIMS=
# For an Azure embeddings model: the deployment name (endpoint/key/version reuse AZURE_OPENAI_* above).
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="your-embeddings-deployment-name"

# JWT Settings
JWT_SECRET_KEY="your-jwt-secret-key"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Database Settings
POSTGRES_HOST=db
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PORT=5432
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Rate Limiting Settings (all optional overrides — see config.py `default_endpoints` for the
# authoritative list and current defaults; only uncomment what you actually want to change).
# Keyed per authenticated user (falls back to IP pre-auth), so these are per-account budgets.
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
# RATE_LIMIT_DATA_AGENT_STREAM="20 per minute"    # the LLM-invoking /query and /query/stream
# RATE_LIMIT_DATA_AGENT_READ="120 per minute"     # /messages, /status — plain DB reads
# RATE_LIMIT_DATA_AGENT_DOWNLOAD="30 per minute"  # artifact/file downloads
# RATE_LIMIT_DATA_CONNECT="10 per minute"
# RATE_LIMIT_LOGIN="20 per minute"
# RATE_LIMIT_REGISTER="10 per hour"

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console


# MCP
MCP_ENABLED=true
MCP_SERVER_PORT=7001
MCP_HOSTNAMES_CSV=mcp:7001

# Data Agent granted folders (served read-only via a per-session deepagents FilesystemBackend).
# Comma-separated host roots that may be granted (read-only) to the agent's file tools.
# Empty = folder grants are DISABLED (secure default). Never include folders with secrets.
# Supports ~ and env-var expansion (e.g. ~, $HOME/agent-data) — resolves to the home of the
# OS user running the server, so avoid hardcoding a username. A drive root (C:/) allows the
# whole drive and defeats the sandbox — don't do that outside single-user local dev.
SANDBOX_ALLOWED_ROOTS=
# SANDBOX_ENABLED=true
# Virtual path the granted folder is exposed at (agent addresses files under this prefix).
# SANDBOX_MOUNT_PATH=/workspace

# Server-managed storage for folders the browser uploads directly (no host path needed from the
# user — works even when the API isn't on the user's machine). Destinations under this root are
# always derived from the authenticated user, never from client input.
# SANDBOX_UPLOAD_ROOT=./sandbox_uploads
# SANDBOX_UPLOAD_MAX_BYTES=209715200
# SANDBOX_UPLOAD_MAX_FILES=500

# Secret used to encrypt persisted credentials at rest (e.g. a bound database password).
# Empty = secure default: passwords are NOT persisted; the user re-enters them per session.
# Any non-empty passphrase works (a Fernet key is derived from it). Use a KMS/secret manager
# in production, not a committed value.
ENCRYPTION_KEY=

# Vetted base URL a user may fetch skills from (single allow-listed host). Empty = fetch disabled.
SKILL_REGISTRY_URL=
